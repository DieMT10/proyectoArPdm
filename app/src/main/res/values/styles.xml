<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!-- Base application theme. -->
  <style name="AppBaseTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
    <!-- Primary brand color. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>

    <!-- Customization for Material components -->
    <item name="colorPrimaryVariant">@color/teal_deep</item>
    <item name="colorSecondary">@color/menta_validacion</item>
    <item name="colorSecondaryVariant">@color/menta_validacion</item>

    <!-- Status bar color -->
    <item name="android:statusBarColor">@color/colorPrimaryDark</item>
  </style>

  <!-- Application theme. -->
  <style name="AppTheme" parent="AppBaseTheme">
  </style>

  <style name="AppTheme.NoActionBar" parent="AppBaseTheme">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
  </style>

</resources>
