<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.proyectoarpdm.helloar.HelloArActivity">

  <android.opengl.GLSurfaceView
      android:id="@+id/surfaceview"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <ImageButton
      android:id="@+id/settings_button"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_margin="25dp"
      android:src="@drawable/ic_settings"
      android:background="@android:color/transparent"
      android:contentDescription="@string/settings_description"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <!-- Main Control Panel -->
  <LinearLayout
      android:id="@+id/control_panel"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="24dp"
      android:orientation="vertical"
      android:background="@drawable/round_background_controls"
      android:padding="8dp"
      android:elevation="6dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <!-- Row 1: Translation (X, Y, Z) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="T" android:textStyle="bold" android:gravity="center" android:textColor="#AAFFFFFF" android:textSize="10sp"/>

      <!-- X -->
      <ImageButton android:id="@+id/btn_move_x_neg" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/arrow_left_svgrepo_com" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/move_x_neg"/>
      <ImageButton android:id="@+id/btn_move_x_pos" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/arrow_right_svgrepo_com" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/move_x_pos"/>

      <View android:layout_width="1dp" android:layout_height="24dp" android:background="#44FFFFFF" android:layout_marginHorizontal="4dp"/>

      <!-- Y -->
      <ImageButton android:id="@+id/btn_move_y_neg" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/arrow_down_svgrepo_com" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/move_y_neg"/>
      <ImageButton android:id="@+id/btn_move_y_pos" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/arrow_up_svgrepo_com" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/move_y_pos"/>

      <View android:layout_width="1dp" android:layout_height="24dp" android:background="#44FFFFFF" android:layout_marginHorizontal="4dp"/>

      <!-- Z -->
      <ImageButton android:id="@+id/btn_move_z_neg" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_arrow_diagonal_down" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/move_z_neg"/>
      <ImageButton android:id="@+id/btn_move_z_pos" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_arrow_diagonal_up" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/move_z_pos"/>
    </LinearLayout>

    <!-- Row 2: Rotation (X, Y, Z) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

      <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="R" android:textStyle="bold" android:gravity="center" android:textColor="#AAFFFFFF" android:textSize="10sp"/>

      <!-- Rot X -->
      <ImageButton android:id="@+id/btn_rotate_x_down" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_rotate" android:rotation="90" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/rotate_x_down"/>
      <ImageButton android:id="@+id/btn_rotate_x_up" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_rotate" android:rotation="270" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/rotate_x_up"/>

      <View android:layout_width="1dp" android:layout_height="24dp" android:background="#44FFFFFF" android:layout_marginHorizontal="4dp"/>

      <!-- Rot Y -->
      <ImageButton android:id="@+id/btn_rotate_y_left" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_rotate" android:rotation="180" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/rotate_y_left"/>
      <ImageButton android:id="@+id/btn_rotate_y_right" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_rotate" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/rotate_y_right"/>

      <View android:layout_width="1dp" android:layout_height="24dp" android:background="#44FFFFFF" android:layout_marginHorizontal="4dp"/>

      <!-- Rot Z -->
      <ImageButton android:id="@+id/btn_rotate_z_left" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_rotate" android:rotation="180" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/rotate_z_left"/>
      <ImageButton android:id="@+id/btn_rotate_z_right" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_rotate" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="6dp" android:contentDescription="@string/rotate_z_right"/>
    </LinearLayout>

    <!-- Row 3: Scale and Reset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

      <ImageButton android:id="@+id/btn_scale_down" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_remove" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="8dp" android:contentDescription="@string/scale_down"/>
      <ImageButton android:id="@+id/btn_scale_up" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_add" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="8dp" android:contentDescription="@string/scale_up"/>

      <View android:layout_width="1dp" android:layout_height="24dp" android:background="#44FFFFFF" android:layout_marginHorizontal="16dp"/>

      <ImageButton android:id="@+id/btn_reset_coords" android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_revert" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@android:color/white" android:scaleType="centerInside" android:padding="8dp" android:contentDescription="@string/reset_coords"/>
    </LinearLayout>

  </LinearLayout>

  <!-- Slideshow Overlay (tomado del XML 2) -->
  <LinearLayout
      android:id="@+id/slideshow_overlay"
      android:layout_width="300dp"
      android:layout_height="400dp"
      android:background="#DDFFFFFF"
      android:orientation="vertical"
      android:padding="16dp"
      android:visibility="gone"
      android:elevation="8dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/slide_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/slide_page_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:textColor="@color/colorPrimary"/>

    <ImageView
        android:id="@+id/slide_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:layout_marginBottom="16dp"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/slide_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/slide_page_indicator"
        android:gravity="center"
        android:textColor="#333333"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        style="?android:attr/buttonBarStyle">

      <Button
          android:id="@+id/btn_prev"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/previous"
          android:layout_marginEnd="8dp"
          style="?android:attr/buttonBarButtonStyle"/>

      <Button
          android:id="@+id/btn_next"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/next"
          android:layout_marginStart="8dp"
          style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close"
        android:layout_marginTop="8dp"
        style="?android:attr/borderlessButtonStyle"/>

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>